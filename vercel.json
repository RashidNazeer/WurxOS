{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://xoaaidgvblondjpvxjqp.supabase.co/functions/v1/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "https://xoaaidgvblondjpvxjqp.supabase.co/functions/v1/mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://xoaaidgvblondjpvxjqp.supabase.co/functions/v1/mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://xoaaidgvblondjpvxjqp.supabase.co/functions/v1/mcp/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/mcp",
      "destination": "https://xoaaidgvblondjpvxjqp.supabase.co/functions/v1/mcp/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration/:rest*",
      "destination": "https://xoaaidgvblondjpvxjqp.supabase.co/functions/v1/mcp/.well-known/openid-configuration"
    },
    {
      "source": "/oauth/:endpoint(register|authorize|decision|token|revoke)",
      "destination": "https://xoaaidgvblondjpvxjqp.supabase.co/functions/v1/mcp/oauth/:endpoint"
    },
    {
      "source": "/sb-auth/:path*",
      "destination": "https://xoaaidgvblondjpvxjqp.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/sb-auth-dev/:path*",
      "destination": "https://vyvkwbvreeycmmnikqbz.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/((?!assets/|sb-auth/|sb-auth-dev/|sw\\.js|logo\\.svg|favicon\\.ico|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
