# ── Demo build ──────────────────────────────────────────────────────────────
# Used by:  npm run build:demo   (vite build --mode demo)
#
# Vite loads .env.demo AFTER .env.local, so these override the production
# values in .env.local. Even so, demoMode.js independently refuses to enable
# demo features if VITE_SUPABASE_URL points at the production project — the
# override and the guard are deliberately two separate mechanisms.
#
# Nothing here is secret: an anon key is public by design, and the demo
# password protects a database of invented people.

VITE_DEMO_MODE=true
VITE_APP_NAME=OpsDeck
VITE_DEMO_PASSWORD=OpsDeckDemo!2026

# Filled in once the demo Supabase project exists.
VITE_SUPABASE_URL=https://rjruqftkzetrltasiouo.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJqcnVxZnRremV0cmx0YXNpb3VvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgyMDY2MjIsImV4cCI6MjEwMzc4MjYyMn0.qk61S7uvxw6ZL4UstZb0nOpZ-uOuR43GzRrylgCEgvM
