{
  "name": "wurxos-assistant-v2",
  "private": true,
  "version": "0.1.0",
  "description": "WurxOS Assistant v2 (agentic hybrid RAG): scripts, tests and dev tooling. Never published.",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test \"supabase/functions/_shared/ai/__tests__/*.test.ts\"",
