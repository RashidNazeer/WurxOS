    "sql:queue": "node scripts/db-dev.mjs sql tests/sql/queue.sql",
    "sql:grants": "node scripts/db-dev.mjs sql tests/sql/grants.sql",
    "sql:search": "node scripts/db-dev.mjs sql tests/sql/search.sql",
    "sql:v1compat": "node scripts/db-dev.mjs sql tests/sql/v1compat.sql",
    "preview": "node --experimental-strip-types scripts/chunk-preview.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "pg": "^8.13.0"
  }
}
